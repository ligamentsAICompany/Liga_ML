PORT=8080
HOST=0.0.0.0
ALLOWED_HOSTS=
CORS_ALLOW_ORIGINS=

HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
GITHUB_TOKEN=
OPENAI_API_KEY=
ML_INTERN_DEFAULT_MODEL_ID=moonshotai/Kimi-K2.6
ML_INTERN_KPIS_DISABLED=1

# Google Cloud / Vertex AI training backend
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GCS_BUCKET=
VERTEX_STAGING_BUCKET=
VERTEX_AI_STAGING_BUCKET=
VERTEX_OUTPUT_DIR=
VERTEX_AI_OUTPUT_DIR=
HF_TOKEN_SECRET_RESOURCE=

# Optional: Vertex runtime service account if jobs should run as a different SA.
VERTEX_AI_SERVICE_ACCOUNT=

# Optional: override the default Vertex AI training image.
GCP_VERTEX_DEFAULT_IMAGE=us-docker.pkg.dev/deeplearning-platform-release/gcr.io/pytorch-cu124.2-4.py310

# Optional durable hosted-session persistence. Cloud Run should use MongoDB for
# restart persistence; local Docker can use the /tmp path for ephemeral files.
MONGODB_URI=
SESSION_STORE_PATH=/tmp/liga-ml-sessions

# Cloud Run should prefer service account identity over baking a
# GOOGLE_APPLICATION_CREDENTIALS file into the image. Use Secret Manager for
# tokens such as HF_TOKEN and OPENAI_API_KEY.

# AWS / SageMaker
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=liga-ml
AWS_SAGEMAKER_ROLE_ARN=
AWS_DEFAULT_INSTANCE_TYPE=ml.g5.xlarge
AWS_DEFAULT_INSTANCE_COUNT=1
AWS_DEFAULT_MAX_RUN_SECONDS=7200
AWS_OUTPUT_POLICY=aws-private
AWS_SAGEMAKER_TRAINING_IMAGE_URI=

# Optional local development only. In Cloud Run, inject AWS credentials via
# Secret Manager-backed env vars or an approved workload identity/federation
# strategy; never commit credential files or bake them into images.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
